<?xml version="1.0" encoding="utf-8"?>
<!--
  browserconfig.xml — devops.houstonalert.com
  Windows / Edge / IE tile configuration.
  References icon-192.png from the Houston Alert icon set.
  Place this file at the repository root.
-->
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo   src="/icons/icon-192.png"/>
      <square150x150logo src="/icons/icon-192.png"/>
      <square310x310logo src="/icons/icon-512.png"/>
      <wide310x150logo   src="/icons/icon-512.png"/>
      <TileColor>#0a0a0a</TileColor>
    </tile>
    <notification>
      <polling-uri  src="https://devops.houstonalert.com/"/>
      <frequency>1440</frequency>
      <cycle>1</cycle>
    </notification>
  </msapplication>
</browserconfig>
